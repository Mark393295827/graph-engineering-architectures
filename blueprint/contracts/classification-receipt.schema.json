{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-engineering/classification-receipt/1.0",
  "title": "Task classification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "task_class", "modalities", "topology", "risk", "confidence", "evidence", "classifier_version", "dynamic_expansion"],
  "properties": {
    "schema_version": { "const": "classification-receipt/1.0" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "status": { "enum": ["CLASSIFIED", "NEEDS_INPUT", "REJECTED"] },
    "task_class": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "modalities": { "type": "array", "minItems": 1, "items": { "enum": ["text", "image", "audio", "video", "document", "code", "mixed"] } },
    "topology": { "enum": ["pipeline", "diamond", "bounded-collection", "maker-checker", "human-gate"] },
    "risk": { "enum": ["low", "material", "consequential"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "classifier_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "dynamic_expansion": { "const": false },
    "unknowns": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
  }
}

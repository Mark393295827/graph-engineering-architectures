{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-engineering/runtime-governance/1.0",
  "title": "Runtime governance policy or evidence receipt",
  "type": "object",
  "required": ["schema_version", "record_type"],
  "properties": {
    "schema_version": { "const": "runtime-governance/1.0" },
    "record_type": { "enum": ["POLICY", "RECEIPT"] }
  },
  "oneOf": [
    { "$ref": "#/$defs/policy" },
    { "$ref": "#/$defs/receipt" }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "artifact_ref": {
      "type": "string",
      "pattern": "^artifact:[A-Za-z0-9._:-]+$"
    },
    "nullable_artifact_ref": {
      "anyOf": [
        { "$ref": "#/$defs/artifact_ref" },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prefixed_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "policy_id",
        "run_scope_ref",
        "hard_limits",
        "enforcement",
        "cache_context_policy",
        "interaction_to_eval_policy",
        "topology_boundary",
        "issued_at"
      ],
      "properties": {
        "schema_version": { "const": "runtime-governance/1.0" },
        "record_type": { "const": "POLICY" },
        "policy_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "run_scope_ref": { "$ref": "#/$defs/artifact_ref" },
        "hard_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_input_tokens",
            "max_output_tokens",
            "max_total_tokens",
            "max_compute_units",
            "compute_meter_ref",
            "max_spend_micros",
            "currency"
          ],
          "properties": {
            "max_input_tokens": { "type": "integer", "minimum": 1 },
            "max_output_tokens": { "type": "integer", "minimum": 1 },
            "max_total_tokens": { "type": "integer", "minimum": 1 },
            "max_compute_units": { "type": "integer", "minimum": 1 },
            "compute_meter_ref": { "$ref": "#/$defs/artifact_ref" },
            "max_spend_micros": { "type": "integer", "minimum": 1 },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "mode",
            "reserve_before_dispatch",
            "unmetered_action",
            "on_exhaustion"
          ],
          "properties": {
            "owner": { "const": "harness-engineering" },
            "mode": { "const": "HARD_PRE_DISPATCH" },
            "reserve_before_dispatch": { "const": true },
            "unmetered_action": { "const": "BLOCK" },
            "on_exhaustion": { "const": "BUDGET_STOP" }
          }
        },
        "cache_context_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "context_manifest_required",
            "stable_prefix_hash_required",
            "prompt_content_in_receipts"
          ],
          "properties": {
            "owner": { "const": "context-manager" },
            "context_manifest_required": { "const": true },
            "stable_prefix_hash_required": { "const": true },
            "prompt_content_in_receipts": { "const": false }
          }
        },
        "interaction_to_eval_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default_action",
            "source_mode",
            "require_explicit_opt_in",
            "require_privacy_scan",
            "require_redaction",
            "require_human_approval",
            "allowed_destination",
            "max_retention_days",
            "automatic_production_mutation",
            "automatic_schema_mutation",
            "automatic_skill_mutation"
          ],
          "properties": {
            "default_action": { "const": "DENY" },
            "source_mode": { "const": "HASHED_REFERENCE_ONLY" },
            "require_explicit_opt_in": { "const": true },
            "require_privacy_scan": { "const": true },
            "require_redaction": { "const": true },
            "require_human_approval": { "const": true },
            "allowed_destination": { "const": "eval-quarantine" },
            "max_retention_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "automatic_production_mutation": { "const": false },
            "automatic_schema_mutation": { "const": false },
            "automatic_skill_mutation": { "const": false }
          }
        },
        "topology_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "graph_dynamic_expansion",
            "graph_feedback_edges",
            "runtime_routing_scope",
            "semantic_change_action"
          ],
          "properties": {
            "graph_dynamic_expansion": { "const": false },
            "graph_feedback_edges": { "const": false },
            "runtime_routing_scope": {
              "const": "PREDECLARED_CAPABILITY_ROUTES"
            },
            "semantic_change_action": {
              "const": "SUPERSEDE_AND_RECOMPILE"
            }
          }
        },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_type",
        "receipt_id",
        "run_id",
        "policy_ref",
        "policy_sha256",
        "run_lock",
        "status",
        "usage",
        "prompt_cache",
        "accepted_outcomes",
        "interaction_to_eval",
        "issued_at"
      ],
      "properties": {
        "schema_version": { "const": "runtime-governance/1.0" },
        "record_type": { "const": "RECEIPT" },
        "receipt_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,95}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
        },
        "policy_ref": { "$ref": "#/$defs/artifact_ref" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "run_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "compiled_run_sha256",
            "graph_sha256",
            "command_sha256"
          ],
          "properties": {
            "compiled_run_sha256": { "$ref": "#/$defs/sha256" },
            "graph_sha256": { "$ref": "#/$defs/sha256" },
            "command_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "status": {
          "enum": ["SUCCEEDED", "PARTIAL", "FAILED", "BUDGET_STOP"]
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens",
            "compute_units",
            "spend_micros",
            "currency",
            "metering_receipt_refs",
            "dispatch_reservation_receipt_refs",
            "budget_stop_dimension",
            "budget_stop_receipt_ref"
          ],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 },
            "compute_units": { "type": "integer", "minimum": 0 },
            "spend_micros": { "type": "integer", "minimum": 0 },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "metering_receipt_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/artifact_ref" }
            },
            "dispatch_reservation_receipt_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/artifact_ref" }
            },
            "budget_stop_dimension": {
              "anyOf": [
                {
                  "enum": [
                    "input_tokens",
                    "output_tokens",
                    "total_tokens",
                    "compute_units",
                    "spend_micros"
                  ]
                },
                { "type": "null" }
              ]
            },
            "budget_stop_receipt_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            }
          }
        },
        "prompt_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "context_manifest_ref",
            "stable_prefix_sha256",
            "uncached_input_tokens",
            "cache_write_input_tokens",
            "cache_read_input_tokens",
            "eligible_requests",
            "hit_requests",
            "evidence_refs",
            "prompt_content_persisted"
          ],
          "properties": {
            "status": { "enum": ["EVIDENCED", "NOT_USED", "UNSUPPORTED"] },
            "context_manifest_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "stable_prefix_sha256": {
              "anyOf": [
                { "$ref": "#/$defs/prefixed_sha256" },
                { "type": "null" }
              ]
            },
            "uncached_input_tokens": { "type": "integer", "minimum": 0 },
            "cache_write_input_tokens": { "type": "integer", "minimum": 0 },
            "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
            "eligible_requests": { "type": "integer", "minimum": 0 },
            "hit_requests": { "type": "integer", "minimum": 0 },
            "evidence_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/artifact_ref" }
            },
            "prompt_content_persisted": { "const": false }
          }
        },
        "accepted_outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verifier_owner",
            "count",
            "acceptance_receipt_refs",
            "cost_per_accepted_outcome"
          ],
          "properties": {
            "verifier_owner": { "const": "verify-before-claim" },
            "count": { "type": "integer", "minimum": 0 },
            "acceptance_receipt_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/artifact_ref" }
            },
            "cost_per_accepted_outcome": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "currency",
                    "total_spend_micros",
                    "accepted_outcome_count",
                    "quotient_micros",
                    "remainder_micros"
                  ],
                  "properties": {
                    "currency": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}$"
                    },
                    "total_spend_micros": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "accepted_outcome_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quotient_micros": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "remainder_micros": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        },
        "interaction_to_eval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "source_interaction_hashes",
            "privacy_profile_ref",
            "opt_in_receipt_ref",
            "privacy_scan_receipt_ref",
            "redaction_receipt_ref",
            "human_approval_receipt_ref",
            "eval_candidate_ref",
            "destination",
            "retention_days",
            "automatic_production_mutation",
            "automatic_schema_mutation",
            "automatic_skill_mutation"
          ],
          "properties": {
            "decision": {
              "enum": [
                "NOT_REQUESTED",
                "DENIED_PRIVACY",
                "DENIED_CONSENT",
                "AWAITING_HUMAN_APPROVAL",
                "PROMOTED_TO_EVAL_QUARANTINE"
              ]
            },
            "source_interaction_hashes": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/prefixed_sha256" }
            },
            "privacy_profile_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "opt_in_receipt_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "privacy_scan_receipt_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "redaction_receipt_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "human_approval_receipt_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "eval_candidate_ref": {
              "$ref": "#/$defs/nullable_artifact_ref"
            },
            "destination": {
              "anyOf": [
                { "const": "eval-quarantine" },
                { "type": "null" }
              ]
            },
            "retention_days": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                { "type": "null" }
              ]
            },
            "automatic_production_mutation": { "const": false },
            "automatic_schema_mutation": { "const": false },
            "automatic_skill_mutation": { "const": false }
          }
        },
        "issued_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}

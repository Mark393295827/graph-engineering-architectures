{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-engineering/blueprint-template/1.0",
  "title": "Bounded task blueprint template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "template_id", "version", "title", "task_classes", "input_slots", "deliverables", "topology", "max_nodes", "capability_requirements", "budget_ceiling", "verifier_pack", "dynamic_expansion"],
  "properties": {
    "schema_version": { "const": "blueprint-template/1.0" },
    "template_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "task_classes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
    "input_slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "media_kinds", "min", "max", "enumeration"],
        "properties": {
          "slot_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "media_kinds": { "type": "array", "minItems": 1, "items": { "enum": ["text", "image", "audio", "video", "document", "code", "mixed"] } },
          "min": { "type": "integer", "minimum": 0 },
          "max": { "type": "integer", "minimum": 1, "maximum": 256 },
          "enumeration": { "const": "precompiled" }
        }
      }
    },
    "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } },
    "topology": { "enum": ["pipeline", "diamond", "bounded-collection", "maker-checker", "human-gate"] },
    "max_nodes": { "type": "integer", "minimum": 1, "maximum": 256 },
    "capability_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" } },
    "budget_ceiling": { "type": "object", "additionalProperties": false, "required": ["max_attempts", "wall_time_seconds", "tool_calls"], "properties": { "max_attempts": { "type": "integer", "minimum": 1, "maximum": 8 }, "wall_time_seconds": { "type": "integer", "minimum": 1 }, "tool_calls": { "type": "integer", "minimum": 1 } } },
    "verifier_pack": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "policy_profile": { "type": "string", "minLength": 1, "maxLength": 100 },
    "loop_policy": { "type": "object", "additionalProperties": false, "required": ["allowed", "max_iterations"], "properties": { "allowed": { "type": "boolean" }, "max_iterations": { "type": "integer", "minimum": 1, "maximum": 8 } } },
    "dynamic_expansion": { "const": false }
  }
}

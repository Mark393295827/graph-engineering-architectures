{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-engineering/graph-admission/1.0",
  "title": "Graph admission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "graph_id",
    "dependency_source",
    "partition_strategy",
    "coupling_profile",
    "critical_path_seconds",
    "serial_work_seconds",
    "peak_parallel_width",
    "structural_hubs",
    "fanout_budget",
    "rate_limit",
    "planner_gate",
    "evidence"
  ],
  "properties": {
    "schema_version": { "const": "graph-admission/1.0" },
    "status": { "enum": ["ADMIT", "SERIAL_ONLY", "NEEDS_INPUT", "RATE_LIMIT_EXCEEDED", "REJECT"] },
    "graph_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dependency_source": { "enum": ["static-analysis", "declared-graph", "manual", "unknown"] },
    "partition_strategy": { "enum": ["dependency-cut", "serial-critical-path", "maker-checker", "manual"] },
    "coupling_profile": { "enum": ["independent", "mixed", "coupled", "needs-input"] },
    "critical_path_seconds": { "type": "number", "minimum": 0 },
    "serial_work_seconds": { "type": "number", "minimum": 0 },
    "critical_path_payback_seconds": { "type": "number", "minimum": 0 },
    "peak_parallel_width": { "type": "integer", "minimum": 1, "maximum": 256 },
    "structural_hubs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "in_degree", "out_degree", "score"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "in_degree": { "type": "integer", "minimum": 0 },
          "out_degree": { "type": "integer", "minimum": 0 },
          "score": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "fanout_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective", "graph_cap"],
      "properties": {
        "requested": { "type": "integer", "minimum": 1, "maximum": 256 },
        "effective": { "type": "integer", "minimum": 1, "maximum": 256 },
        "graph_cap": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_rate_rps", "limit_rps", "projected_rps", "status"],
      "properties": {
        "worker_rate_rps": { "type": "number", "exclusiveMinimum": 0 },
        "limit_rps": { "type": "number", "exclusiveMinimum": 0 },
        "projected_rps": { "type": "number", "minimum": 0 },
        "status": { "enum": ["WITHIN_LIMIT", "EXCEEDS_LIMIT", "UNKNOWN"] }
      }
    },
    "planner_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status", "token_cost"],
      "properties": {
        "mode": { "enum": ["script-preflight", "disabled"] },
        "status": { "enum": ["PASS", "DISABLED", "REJECT"] },
        "token_cost": { "const": 0 },
        "elapsed_ms": { "type": "number", "minimum": 0 }
      }
    },
    "coordination_tax_ceiling_percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "reasons": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  }
}

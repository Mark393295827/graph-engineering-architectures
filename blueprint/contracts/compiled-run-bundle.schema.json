{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-engineering/compiled-run-bundle/1.0",
  "title": "Compiled run bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "task_ref", "classification_ref", "template_lock", "graph_ref", "team_command_ref", "media_manifest_ref", "policy_ref", "run_lock"],
  "properties": {
    "schema_version": { "const": "compiled-run-bundle/1.0" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "status": { "enum": ["COMPILED_UNCONFIRMED", "CONTRACT_VALIDATED", "STRUCTURE_CONFIRMED", "RUNTIME_READY", "RUNNING", "VERIFYING", "SUCCEEDED", "PARTIAL", "FAILED", "SUPERSEDED"] },
    "task_ref": { "type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$" },
    "classification_ref": { "type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$" },
    "template_lock": { "type": "object", "additionalProperties": false, "required": ["template_id", "version", "sha256"], "properties": { "template_id": { "type": "string" }, "version": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "graph_ref": { "type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$" },
    "team_command_ref": { "type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$" },
    "media_manifest_ref": { "type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$" },
    "policy_ref": { "type": "string", "pattern": "^artifact:[A-Za-z0-9._:-]+$" },
    "run_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_sha256", "template_sha256", "compiler_sha256", "schema_sha256", "policy_sha256", "adapter_registry_sha256", "graph_sha256", "command_sha256", "media_manifest_sha256"],
      "properties": {
        "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "template_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "compiler_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "schema_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "adapter_registry_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "graph_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "command_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "graph-engineering/task-spec/1.0",
  "title": "Task specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "inputs",
    "deliverables",
    "success_criteria",
    "constraints",
    "budgets"
  ],
  "properties": {
    "schema_version": { "const": "task-spec/1.0" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_version_ref", "media_kind"],
        "properties": {
          "asset_version_ref": { "type": "string", "pattern": "^(asset|sha256):[A-Za-z0-9._:-]+$" },
          "media_kind": { "enum": ["text", "image", "audio", "video", "document", "code", "mixed"] },
          "role": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "media_kind", "format_profile"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "media_kind": { "enum": ["text", "image", "audio", "video", "document", "code", "mixed"] },
          "format_profile": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy_profile", "effect_policy", "non_goals", "unknowns"],
      "properties": {
        "privacy_profile": { "type": "string", "minLength": 1 },
        "effect_policy": { "enum": ["read-only", "review-required", "human-gated-external"] },
        "non_goals": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
        "unknowns": { "type": "array", "items": { "type": "string", "maxLength": 1000 } }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_nodes", "max_concurrency", "max_attempts", "wall_time_seconds", "context_bytes", "media_bytes", "tool_calls"],
      "properties": {
        "max_nodes": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "wall_time_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "context_bytes": { "type": "integer", "minimum": 1 },
        "media_bytes": { "type": "integer", "minimum": 1 },
        "tool_calls": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    }
  }
}
